// The typed interface QML binds as logos.module("collect_ui").
//
// This mirrors collect_core's derived contract one-for-one — see
// docs/api-verification.md round 3 for the .lidl. Everything crosses as a
// JSON string because that is all collect_core's Rust ABI accepts
// (String/i64/u64/f64/bool/Vec<u8>/Option<T>), and re-encoding into a second
// shape here would be two contracts to keep in step.
//
// PROPs auto-sync, which suits the long-lived surfaces: the header's node
// state changes underneath the view rather than being polled. SLOTs return
// through logos.watch(call, onOk, onErr).
//
// SPEC Q12 is still open: if collect_ui becomes a `ui-qml` module, this file
// and the backend go away and QML calls logos.callModule("collect_core", ...)
// directly. The screens and the form renderer are unaffected either way —
// they read from Core.qml.
class CollectUi
{
    // What collect_core reports it can do, as JSON. Filled on context-ready,
    // so the UI can disable what is not wired instead of failing at the call.
    PROP(QString capabilities="{}" READONLY)

    // Whether collect_core answered at all.
    PROP(bool coreReady=false READONLY)

    // The experiment and its protocols, as collect_core returns them from
    // experiments.open. A PROP rather than a slot because the view wants it
    // on arrival, not on request — and when a newer manifest lands over
    // Delivery, pushing it here is how the screens find out.
    PROP(QString documents="{}" READONLY)

    // The generic entry point: a SPEC section 6 method name plus its JSON
    // request. One slot rather than thirteen, because the UI already holds
    // the method names in Core.qml and a second copy here would be a second
    // thing to keep in step.
    SLOT(QString call(QString method, QString request))
}
